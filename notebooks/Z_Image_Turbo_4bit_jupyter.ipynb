    86|      "cell_type": "code",
    87|      "source": [
    88|        "from fastapi import FastAPI, HTTPException\n",
    89|        "from fastapi.middleware.cors import CORSMiddleware\n",
    90|        "from pydantic import BaseModel\n",
    91|        "from io import BytesIO\n",
    92|        "import base64\n",
    93|        "import torch\n",
    94|        "import uvicorn\n",
    95|        "import threading\n",
    96|        "import time\n",
    97|        "\n",
    98|        "app = FastAPI()\n",
    99|        "app.add_middleware(CORSMiddleware, allow_origins=[\"*\"])\n",
   100|        "\n",
   101|        "TOKEN = 'YOUR_SECRET_TOKEN'\n",
   102|        "\n",
   103|        "class Req(BaseModel):\n",
   104|        "    prompt: str\n",
   105|        "    token: str\n",
   106|        "\n",
   107|        "@app.get(\"/health\")\n",
   108|        "async def health():\n",
   109|        "    return {\"status\": \"ok\"}\n",
   110|        "\n",
   111|        "@app.post(\"/generate\")\n",
   112|        "async def generate(req: Req):\n",
   113|        "    # Validação do token agora via parâmetro no corpo da request\n",
   114|        "    if req.token != TOKEN:\n",
   115|        "        raise HTTPException(status_code=401, detail=\"Invalid Token\")\n",
   116|        "\n",
   117|        "    image = pipe(prompt=req.prompt, height=1024, width=1024,\n",
   118|        "                 num_inference_steps=9, guidance_scale=0.0,\n",
   119|        "                 generator=torch.manual_seed(42)).images[0]\n",
   120|        "    buf = BytesIO()\n",
   121|        "    image.save(buf, format=\"PNG\")\n",
   122|        "    return {\"image\": base64.b64encode(buf.getvalue()).decode()}\n",
   123|        "\n",
   124|        "# Mata qualquer processo que esteja usando a porta 8081\n",
   125|        "!fuser -k 8081/tcp\n",
   126|        "\n",
   127|        "def run_server():\n",
   128|        "    config = uvicorn.Config(app, host=\"0.0.0.0\", port=8081, log_level=\"info\")\n",
   129|        "    server = uvicorn.Server(config)\n",
   130|        "    server.run()\n",
   131|        "\n",
   132|        "# Inicia em Thread para compartilhar memória\n",
   133|        "thread = threading.Thread(target=run_server, daemon=True)\n",
   134|        "thread.start()\n",
   135|        "\n",
   136|        "time.sleep(2)\n",
   137|        "print(\"🚀 Servidor reiniciado. Token agora deve ser enviado no corpo do JSON.\")"
   138|      ],
