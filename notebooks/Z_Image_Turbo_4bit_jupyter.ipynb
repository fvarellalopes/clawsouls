    32|        "import torch\n",
    33|        "import diffusers\n",
    34|        "from sdnq import SDNQConfig # import sdnq to register it into diffusers and transformers\n",
    35|        "from sdnq.loader import apply_sdnq_options_to_model\n",
    36|        "\n",
    37|        "pipe = diffusers.ZImagePipeline.from_pretrained(\"Disty0/Z-Image-Turbo-SDNQ-uint4-svd-r32\", torch_dtype=torch.float32, device_map=\"cuda\")\n",
    38|        "pipe.transformer = apply_sdnq_options_to_model(pipe.transformer, use_quantized_matmul=True)\n",
    39|        "pipe.text_encoder = apply_sdnq_options_to_model(pipe.text_encoder, use_quantized_matmul=True)"
