   139|      "source": [
   140|        "\n",
   141|        "# Escreve o servidor num arquivo .py para que o uvicorn consira importá-lo corretamente.\n",
   142|        "# O notebook não serve como módulo para o uvicorn (--reload).\n",
   143|        "\n",
   144|        "import textwrap\n",
   145|        " # Silenciar warnings de Flax\n",
   146|        "import warnings, os\n",
   147|        "warnings.filterwarnings(\"ignore\", category=DeprecationWarning)\n",
   148|        "os.environ[\"TRANSFORMERS_VERBOSITY\"] = \"error\"\n",
   149|        "\n",
   150|        "!pip install -q fastapi uvicorn[standard] pydantic pillow\n",
   151|        "!pip install -q diffusers[torch] transformers accelerate torch torchvision safetensors\n",
   152|        "\n",
   153|        "# cloudflared não está no PyPI — baixa o binário direto do GitHub\n",
   154|        "!wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /usr/local/bin/cloudflared\n",
   155|        "!chmod +x /usr/local/bin/cloudflared\n",
   156|        "\n",
   157|        "print(\"✅ Dependências instaladas!\")\n",
   158|        "\n",
   159|        "server_code = textwrap.dedent('''\n",
   160|        "    from urllib.parse import parse_qs\n",
   161|        "    import io, base64, time, os, re\n",
   162|        "    from datetime import datetime\n",
   163|        "    from typing import Optional\n",
   164|        "\n",
   165|        "    from pydantic import BaseModel\n",
   166|        "    from fastapi import FastAPI, HTTPException, Header, Request\n",
   167|        "    import torch\n",
   168|        "    from diffusers import AutoPipelineForText2Image\n",
   169|        "\n",
   170|        "    # ── Config (injetadas pelo notebook via env vars) ──────────\n",
   171|        "    MODELO = os.environ.get('CLAWSOULS_MODELO', 'sdxl')\n",
   172|        "    SECRET_TOKEN = os.environ.get('CLAWSOULS_SECRET', 'YOUR_SECRET_TOKEN')\n",
   173|        "    TOTAL_STEPS = int(os.environ.get('CLAWSOULS_STEPS', '15'))\n",
   174|        "    TOTAL_GUIDANCE = float(os.environ.get('CLAWSOULS_GUIDANCE', '7.5'))\n",
   175|        "    MODEL_ID = os.environ.get('CLAWSOULS_MODEL_ID', 'stabilityai/stable-diffusion-xl-base-1.0')\n",
   176|        "    MODEL_WIDTH = int(os.environ.get('CLAWSOULS_WIDTH', '512'))\n",
   177|        "    MODEL_HEIGHT = int(os.environ.get('CLAWSOULS_HEIGHT', '768'))\n",
   178|        "\n",
   179|        "    # ── Prompt Engine ────────────────────────────────────────\n",
   180|        "    EMOJI_HINTS = {\n",
   181|        "        '🔬': 'scientific goggles, lab coat details',\n",
   182|        "        '🕵️': 'detective hat, trench coat',\n",
   183|        "        '🌟': 'sparkles, star-shaped accessories',\n",
   184|        "        '⚡': 'electric energy aura, lightning motifs',\n",
   185|        "        '🧘': 'lotus position, meditation beads, serene',\n",
   186|        "        '🤖': 'mechanical parts, circuit patterns',\n",
   187|        "        '🏴‍☠️': 'pirate bandana, adventurous look',\n",
   188|        "        '💻': 'techwear, holographic screen elements',\n",
   189|        "        '🎤': 'microphone, stage lights, glamorous',\n",
   190|        "        '🌳': 'nature elements, leaves, organic flowing design',\n",
   191|        "        '🕶️': 'sunglasses, cool demeanor',\n",
   192|        "        '😈': 'mischievous grin, horns, dark aesthetic',\n",
   193|        "        '👽': 'alien features, cosmic glow',\n",
   194|        "        '🐉': 'dragon scales, mythical aura',\n",
   195|        "        '🦊': 'fox ears, cunning expression',\n",
   196|        "        '🐱': 'cat ears, playful whiskers',\n",
   197|        "        '👁️': 'mystical third eye, all-seeing aura',\n",
   198|        "        '💀': 'skull motifs, dark mysticism',\n",
   199|        "        '🎭': 'theater mask, dramatic duality',\n",
   200|        "    }\n",
   201|        "\n",
   202|        "    DOMAIN_ACCENTS = {\n",
   203|        "        'tech': 'circuit patterns, holographic UI elements',\n",
   204|        "        'philosophy': 'ancient scrolls, ethereal glow',\n",
   205|        "        'science': 'molecular structures, lab equipment details',\n",
   206|        "        'arts': 'paint splashes, creative chaos',\n",
   207|        "        'history': 'ancient runes, time-worn textures',\n",
   208|        "        'literature': 'floating text, book pages',\n",
   209|        "        'pop-culture': 'retro gaming elements, neon signs',\n",
   210|        "        'sports': 'athletic build, competitive energy',\n",
   211|        "        'business': 'sharp suit, corporate confidence',\n",
   212|        "        'psychology': 'thoughtful gaze, abstract mind visuals',\n",
   213|        "    }\n",
   214|        "\n",
   215|        "    def build_prompt(soul: dict) -> str:\n",
   216|        "        creature = soul.get('creature', 'mysterious entity')\n",
   217|        "        vibe = soul.get('vibe', 'enigmatic')\n",
   218|        "        emoji = soul.get('emoji', '')\n",
   219|        "        humor = soul.get('humor', 50)\n",
   220|        "        formality = soul.get('formality', 50)\n",
   221|        "        vibe_style = soul.get('vibeStyle', 'concise')\n",
   222|        "        knowledge_domains = soul.get('knowledgeDomains', [])\n",
   223|        "        emotional_range = soul.get('emotionalRange', 50)\n",
   224|        "        agreeableness = soul.get('agreeableness', 50)\n",
   225|        "        extraversion = soul.get('extraversion', 50)\n",
   226|        "        openness = soul.get('openness', 70)\n",
   227|        "        neuroticism = soul.get('neuroticism', 30)\n",
   228|        "        is_high_formality = formality > 65\n",
   229|        "        is_playful = humor > 65\n",
   230|        "        is_minimal = vibe_style == 'minimal'\n",
   231|        "        is_concise = vibe_style == 'concise'\n",
   232|        "        is_dramatic = emotional_range > 75 or vibe_style == 'dramatic'\n",
   233|        "        is_tech = any(d in ('tech', 'science') for d in knowledge_domains)\n",
   234|        "        art_style = 'cyberpunk digital illustration'\n",
   235|        "        if is_high_formality:\n",
   236|        "            art_style = 'elegant digital painting, Renaissance lighting'\n",
   237|        "        elif is_playful:\n",
   238|        "            art_style = 'colorful anime-inspired digital art, vibrant'\n",
   239|        "        elif is_minimal:\n",
   240|        "            art_style = 'minimalist vector art, clean lines, geometric'\n",
   241|        "        elif is_tech:\n",
   242|        "            art_style = 'sci-fi concept art, holographic elements'\n",
   243|        "        elif is_dramatic:\n",
   244|        "            art_style = 'cinematic digital painting, dramatic chiaroscuro lighting'\n",
   245|        "        atmosphere = 'dark atmospheric background with neon accents'\n",
   246|        "        if agreeableness > 70:\n",
   247|        "            atmosphere = 'warm, inviting background with soft golden light'\n",
   248|        "        elif neuroticism > 60:\n",
   249|        "            atmosphere = 'unstable, glitching background with fractured light'\n",
   250|        "        elif extraversion > 70:\n",
   251|        "            atmosphere = 'dynamic, energetic background with bold colors'\n",
   252|        "        elif openness > 75:\n",
   253|        "            atmosphere = 'dreamy, surreal background with cosmic elements'\n",
   254|        "        expression = 'calm, confident expression'\n",
   255|        "        if neuroticism > 60:\n",
   256|        "            expression = 'tense, alert expression'\n",
   257|        "        elif extraversion > 70:\n",
   258|        "            expression = 'bright, engaging smile'\n",
   259|        "        elif agreeableness > 70:\n",
   260|        "            expression = 'gentle, warm expression'\n",
   261|        "        elif openness > 70:\n",
   262|        "            expression = 'curious, contemplative gaze'\n",
   263|        "        elif humor > 70:\n",
   264|        "            expression = 'sly, playful smirk'\n",
   265|        "        descriptors = [creature, vibe]\n",
   266|        "        if expression != 'calm, confident expression':\n",
   267|        "            descriptors.append(expression)\n",
   268|        "        descriptors.append(art_style)\n",
   269|        "        if not is_concise and not is_minimal:\n",
   270|        "            descriptors.append('vibe: ' + vibe_style)\n",
   271|        "        if emoji and emoji in EMOJI_HINTS:\n",
   272|        "            descriptors.append(EMOJI_HINTS[emoji])\n",
   273|        "        for domain in knowledge_domains:\n",
   274|        "            if domain in DOMAIN_ACCENTS:\n",
   275|        "                descriptors.append(DOMAIN_ACCENTS[domain])\n",
   276|        "        descriptors.append('unique, one-of-a-kind character design')\n",
   277|        "        prompt = (\n",
   278|        "            'close-up portrait, centered, detailed face, '\n",
   279|        "            + 'professional character art of ' + creature + ', '\n",
   280|        "            + ', '.join(descriptors[1:]) + ', '\n",
   281|        "            + atmosphere + ', highly detailed, 4k, masterpiece'\n",
   282|        "        )\n",
   283|        "        return prompt.strip()\n",
   284|        "\n",
   285|        "    def build_negative_prompt() -> str:\n",
   286|        "        return (\n",
   287|        "            'blurry, low quality, deformed, ugly, duplicate, disfigured, '\n",
   288|        "            'bad anatomy, bad proportions, extra limbs, mutated hands, '\n",
   289|        "            'text, watermark, signature, logo, '\n",
   290|        "            'photorealistic, 3d render, '\n",
   291|        "            'nude, NSFW, gore'\n",
   292|        "        )\n",
   293|        "\n",
   294|        "    # ── FastAPI App ────────────────────────────────────────\n",
   295|        "    class GenerateRequest(BaseModel):\n",
   296|        "        name: str\n",
   297|        "        creature: Optional[str] = 'mysterious entity'\n",
   298|        "        vibe: Optional[str] = 'enigmatic'\n",
   299|        "        emoji: Optional[str] = ''\n",
   300|        "        humor: Optional[int] = 50\n",
   301|        "        formality: Optional[int] = 50\n",
   302|        "        emojiUsage: Optional[int] = 20\n",
   303|        "        knowledgeDomains: Optional[list] = []\n",
   304|        "        emotionalRange: Optional[int] = 50\n",
   305|        "        vibeStyle: Optional[str] = 'concise'\n",
   306|        "        agreeableness: Optional[int] = 50\n",
   307|        "        extraversion: Optional[int] = 50\n",
   308|        "        openness: Optional[int] = 70\n",
   309|        "        neuroticism: Optional[int] = 30\n",
   310|        "        steps: Optional[int] = None\n",
   311|        "        guidance: Optional[float] = None\n",
   312|        "        custom_prompt: Optional[str] = None\n",
   313|        "\n",
   314|        "    app = FastAPI(title='ClawSouls Avatar API', version='2.0')\n",
   315|        "\n",
   316|        "    def _check_token(request: Request) -> bool:\n",
   317|        "        auth = request.headers.get('Authorization', '')\n",
   318|        "        if auth == 'Bearer ' + SECRET_TOKEN:\n",
   319|        "            return True\n",
   320|        "        qs = parse_qs(request.url.query)\n",
   321|        "        if qs.get('token', [''])[0] == SECRET_TOKEN:\n",
   322|        "            return True\n",
   323|        "        if request.headers.get('X-Token') == SECRET_TOKEN:\n",
   324|        "            return True\n",
   325|        "        return False\n",
   326|        "\n",
   327|        "    @app.get('/health')\n",
   328|        "    def health():\n",
   329|        "        return {'status': 'ok', 'model': MODELO, 'model_id': MODEL_ID}\n",
   330|        "\n",
   331|        "    @app.get('/models')\n",
   332|        "    def list_models():\n",
   333|        "        return {'available': {}, 'current': MODELO}\n",
   334|        "\n",
   335|        "    @app.post('/generate')\n",
   336|        "    async def generate(request: Request, req: GenerateRequest):\n",
   337|        "        if not _check_token(request):\n",
   338|        "            raise HTTPException(status_code=401, detail='Unauthorized')\n",
   339|        "        if req.custom_prompt:\n",
   340|        "            prompt = req.custom_prompt\n",
   341|        "        else:\n",
   342|        "            d = req.dict()\n",
   343|        "            d.pop('steps', None)\n",
   344|        "            d.pop('guidance', None)\n",
   345|        "            d.pop('custom_prompt', None)\n",
   346|        "            prompt = build_prompt(d)\n",
   347|        "        negative = build_negative_prompt()\n",
   348|        "        steps = req.steps if req.steps else TOTAL_STEPS\n",
   349|        "        guidance = req.guidance if req.guidance else TOTAL_GUIDANCE\n",
   350|        "        print(f\"[{datetime.now().strftime('%H:%M:%S')}] Generating: {req.name} ({steps} steps)\")\n",
   351|        "        start = time.time()\n",
   352|        "        generator = torch.Generator(device='cuda').manual_seed(int(time.time() * 1000) % (2**32))\n",
   353|        "        image = pipe(\n",
   354|        "            prompt=prompt, negative_prompt=negative,\n",
   355|        "            num_inference_steps=steps, guidance_scale=guidance,\n",
   356|        "            width=MODEL_WIDTH, height=MODEL_HEIGHT, generator=generator,\n",
   357|        "        ).images[0]\n",
   358|        "        elapsed = time.time() - start\n",
   359|        "        buf = io.BytesIO()\n",
   360|        "        image.save(buf, format='PNG')\n",
   361|        "        buf.seek(0)\n",
   362|        "        img_b64 = base64.b64encode(buf.read()).decode('utf-8')\n",
   363|        "        safe_name = ''.join(c if c.isalnum() or c in '._-' else '_' for c in req.name.lower().strip())\n",
   364|        "        print(f\"   ✅ {req.name} → {elapsed:.1f}s\")\n",
   365|        "        return {\n",
   366|        "            'name': req.name, 'slug': safe_name, 'prompt': prompt,\n",
   367|        "            'negative_prompt': negative, 'seed': int(generator.initial_seed()),\n",
   368|        "            'steps': steps, 'guidance': guidance, 'model': MODELO,\n",
   369|        "            'elapsed_s': round(elapsed, 1), 'image_base64': img_b64,\n",
   370|        "        }\n",
   371|        "\n",
   372|        "    # ── Lifespan (model loading) ─────────────────────────────\n",
   373|        "    from contextlib import asynccontextmanager\n",
   374|        "\n",
   375|        "    @asynccontextmanager\n",
   376|        "    async def lifespan(app):\n",
   377|        "        global pipe\n",
   378|        "        variant = os.environ.get('CLAWSOULS_VARIANT', 'fp16')\n",
   379|        "        pipe = AutoPipelineForText2Image.from_pretrained(\n",
   380|        "            MODEL_ID,\n",
   381|        "            torch_dtype=torch.float16 if variant == 'fp16' else torch.float32,\n",
   382|        "            variant=variant if variant != 'fp32' else None,\n",
   383|        "            use_safetensors=True,\n",
   384|        "        )\n",
   385|        "        pipe.enable_attention_slicing()\n",
   386|        "        if hasattr(pipe, 'enable_vae_tiling'):\n",
   387|        "            pipe.enable_vae_tiling()\n",
   388|        "        pipe.to('cuda')\n",
   389|        "        # Fix: forçar VAE no mesmo dtype pra evitar RuntimeError de mixed precision\n",
   390|        "        if hasattr(pipe, 'vae'):\n",
   391|        "            pipe.vae.to(torch_device='cuda', torch_dtype=torch.float16)\n",
   392|        "        print('✅ Modelo carregado: ' + MODEL_ID)\n",
   393|        "        yield\n",
   394|        "        del pipe\n",
   395|        "        torch.cuda.empty_cache()\n",
   396|        "        print('🛑 Servidor encerrado')\n",
   397|        "\n",
   398|        "    app.router.lifespan_context = lifespan\n",
   399|        "\n",
   400|        "''')\n",
   401|        "\n",
   402|        "# Injecta config do notebook como env vars pro server.py ler\n",
   403|        "import os as _os\n",
   404|        "_os.environ['CLAWSOULS_MODELO'] = MODELO\n",
   405|        "_os.environ['CLAWSOULS_SECRET'] = SECRET_TOKEN\n",
   406|        "_os.environ['CLAWSOULS_STEPS'] = str(TOTAL_STEPS)\n",
   407|        "_os.environ['CLAWSOULS_GUIDANCE'] = str(TOTAL_GUIDANCE)\n",
   408|        "_os.environ['CLAWSOULS_MODEL_ID'] = MODEL_ID\n",
   409|        "_os.environ['CLAWSOULS_WIDTH'] = str(cfg['width'])\n",
   410|        "_os.environ['CLAWSOULS_HEIGHT'] = str(cfg['height'])\n",
   411|        "_os.environ['CLAWSOULS_VARIANT'] = cfg['variant']\n",
   412|        "\n",
   413|        "# Grava o server.py\n",
   414|        "with open('/content/server.py', 'w') as f:\n",
   415|        "    f.write(server_code)\n",
   416|        "\n",
   417|        "print('✅ server.py gravado!')\n"
   418|      ]
   419|    },
   420|    {
   421|      "cell_type": "code",
   422|      "execution_count": 12,
   423|      "metadata": {
   424|        "colab": {
