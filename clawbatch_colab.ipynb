    "# ============================================================\n",
    "# CÉLULA 4 — Configurações (ajuste conforme necessário)\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "# ── Modelo SDXL ──────────────────────────────────────────\n",
    "# Pode trocar por outro modelo compatível com diffusers\n",
    "os.environ[\"SD_MODEL_ID\"] = \"stabilityai/stable-diffusion-xl-base-1.0\"\n",
    "\n",
    "# ── Resolução ───────────────────────────────────────────\n",
    "# SDXL: 512×768 (retrato) | 768×512 (paisagem)\n",
    "os.environ[\"AVATAR_WIDTH\"] = \"512\"\n",
    "os.environ[\"AVATAR_HEIGHT\"] = \"768\"\n",
    "\n",
    "# ── Qualidade ───────────────────────────────────────────\n",
    "# Mais steps = melhor qualidade, mas mais lento (20-30 é bom)\n",
    "os.environ[\"AVATAR_STEPS\"] = \"25\"\n",
    "os.environ[\"AVATAR_GUIDANCE\"] = \"7.5\"\n",
    "\n",
    "# ── Fonte dos presets ───────────────────────────────────\n",
    "# 'file'  = lê do data/presets.ts do repositório (289 presets)\n",
    "# 'hardcoded' = usa apenas os presets embutidos no script (12 presets)\n",
    "os.environ[\"PRESETS_SOURCE\"] = \"file\"  # ← Recomendado!\n",
    "\n",
    "# ── Diretórios ──────────────────────────────────────────\n",
    "OUTPUT_DIR = \"/content/avatars\"\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "print(f\"📐 Resolução : {os.environ['AVATAR_WIDTH']}×{os.environ['AVATAR_HEIGHT']}\")\n",
    "print(f\"🔧 Steps      : {os.environ['AVATAR_STEPS']}\")\n",
    "print(f\"🎯 Guidance   : {os.environ['AVATAR_GUIDANCE']}\")\n",
    "print(f\"📋 Presets    : {os.environ['PRESETS_SOURCE']}\")\n",
    "print(f\"📁 Output     : {OUTPUT_DIR}\")"
   ]
