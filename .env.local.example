# ClawSouls Environment Variables
# Copy this file to .env.local and configure as needed

# Upstash Redis (rate limiting) — get from Vercel Marketplace or upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Optional: Custom domain (for OpenGraph)
NEXT_PUBLIC_SITE_URL=https://clawsouls.hub

# Optional: Supabase (for shared_souls and preset_ratings)
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
